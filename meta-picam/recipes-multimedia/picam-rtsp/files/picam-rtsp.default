# Override these if you need a different RTSP URL or input pipeline.
PICAM_RTSP_PORT=8554
PICAM_RTSP_MOUNT=/camera

# The camera is captured by picam-mjpeg and fanned out as RTP/H264 on localhost.
# PICAM_RTSP_PIPELINE=( udpsrc port=5004 caps="application/x-rtp,media=(string)video,encoding-name=(string)H264,payload=(int)96,clock-rate=(int)90000" ! rtph264depay ! h264parse config-interval=1 ! rtph264pay name=pay0 pt=96 )
